{
  "info": {
    "name": "LMS Course & Curriculum API",
    "description": "Collection for testing Course, Module, Lesson, and Topic management endpoints. Autowired with Bearer Token auth at the collection level.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@transetu.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Submit email and password to receive a JWT access token. Place this token in the collection variable `authToken` to authorize all other requests."
          }
        }
      ]
    },
    {
      "name": "1. Course CRUD & Curriculum",
      "item": [
        {
          "name": "Create Course (Single)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Java Programming Masterclass: Zero to Hero\",\n  \"description\": \"Learn Java from absolute scratch including variables, control flows, OOP, and exception handling.\",\n  \"thumbnail_url\": \"https://images.unsplash.com/photo-1517694712202-14dd9538aa97\",\n  \"status\": \"draft\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses"
              ]
            },
            "description": "Create a new course in draft status."
          }
        },
        {
          "name": "Create Course (Complete Java Nested Structure)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Java Programming Masterclass: Zero to Hero\",\n  \"description\": \"A comprehensive guide to learning Java from scratch, covering OOP, Collections, Concurrency, and advanced software design patterns.\",\n  \"thumbnail_url\": \"https://images.unsplash.com/photo-1517694712202-14dd9538aa97\",\n  \"status\": \"draft\",\n  \"modules\": [\n    {\n      \"name\": \"Module 1: Fundamentals of Java\",\n      \"description\": \"Introduction to Java, setting up the JDK, writing Hello World, variables, and loops.\",\n      \"order_num\": 1,\n      \"is_locked\": false,\n      \"lessons\": [\n        {\n          \"name\": \"Lesson 1.1: Java Setup and IDE Config\",\n          \"type\": \"mixed\",\n          \"content_text\": \"Steps to configure Java Development Kit (JDK) and IntelliJ IDEA.\",\n          \"duration_minutes\": 15,\n          \"order_num\": 1,\n          \"topics\": [\n            {\n              \"name\": \"Topic 1.1.1: History of Java & JVM\",\n              \"description\": \"Understand Java's platform independence and compiled nature.\",\n              \"content_text\": \"Java compiles bytecode that runs on the JVM.\",\n              \"order_num\": 1\n            },\n            {\n              \"name\": \"Topic 1.1.2: Installing OpenJDK 17\",\n              \"description\": \"Downloading and installing the LTS JDK version.\",\n              \"content_text\": \"Setup PATH environment variable for JDK.\",\n              \"order_num\": 2\n            }\n          ]\n        },\n        {\n          \"name\": \"Lesson 1.2: Your First Java Program\",\n          \"type\": \"text\",\n          \"content_text\": \"Deconstructing public static void main(String[] args).\",\n          \"duration_minutes\": 10,\n          \"order_num\": 2,\n          \"topics\": [\n            {\n              \"name\": \"Topic 1.2.1: Anatomy of main()\",\n              \"description\": \"Why we write standard boilerplate and syntax.\",\n              \"content_text\": \"The main method is the execution entrance.\",\n              \"order_num\": 1\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"name\": \"Module 2: Object-Oriented Programming (OOP)\",\n      \"description\": \"Delve into classes, objects, inheritance, polymorphism, encapsulation, and abstraction.\",\n      \"order_num\": 2,\n      \"is_locked\": true,\n      \"lessons\": [\n        {\n          \"name\": \"Lesson 2.1: Defining Classes and Constructors\",\n          \"type\": \"mixed\",\n          \"content_text\": \"Learn constructor overloading and Heap memory allocations.\",\n          \"duration_minutes\": 20,\n          \"order_num\": 1,\n          \"topics\": [\n            {\n              \"name\": \"Topic 2.1.1: Default vs Parametrized Constructors\",\n              \"description\": \"Creating objects with custom states.\",\n              \"content_text\": \"How constructor invocation initializes fields.\",\n              \"order_num\": 1\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses"
              ]
            },
            "description": "Highly powerful endpoint showing how to create a course with modules, lessons, and topics in a single nested request body."
          }
        },
        {
          "name": "Get Courses with Pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses?page=1&limit=10&status=draft&search=Java",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page index (defaults to 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Limit size (defaults to 10, max 50)"
                },
                {
                  "key": "status",
                  "value": "draft",
                  "description": "Filter by status: active, inactive, archived, draft"
                },
                {
                  "key": "search",
                  "value": "Java",
                  "description": "Case-insensitive substring search for name"
                }
              ]
            },
            "description": "List courses with offset pagination, search matching, status filtering, and count fields."
          }
        },
        {
          "name": "Lightweight Active Courses Lookup",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses/lookup?search=Java&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses",
                "lookup"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Java",
                  "description": "Filter active courses by name"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Max rows to return (defaults to 10, max 50)"
                }
              ]
            },
            "description": "Retrieve a list of active courses with lightweight fields: id and name."
          }
        },
        {
          "name": "General Course Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses",
                "stats"
              ]
            },
            "description": "Retrieve counts of total, active, draft, and archived courses."
          }
        },
        {
          "name": "Get Detailed Course by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Course database ID"
                }
              ]
            },
            "description": "Fetch a specific course with its nested curriculum modules, lessons, and topics."
          }
        },
        {
          "name": "Update Course",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Java Programming Masterclass: Complete Guide\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Course ID to update"
                }
              ]
            },
            "description": "Update metadata or publish status of a course. Accepted status values: active, inactive, archived, draft."
          }
        },
        {
          "name": "Delete Course",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Course ID to delete"
                }
              ]
            },
            "description": "Soft delete a course from the DB. Only allowed for admins."
          }
        },
        {
          "name": "Fetch Course Curriculum Structure",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses/:id/curriculum?student_id=1&enrollment_id=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses",
                ":id",
                "curriculum"
              ],
              "query": [
                {
                  "key": "student_id",
                  "value": "1",
                  "description": "Optional: fetches locked states and lesson completions for student"
                },
                {
                  "key": "enrollment_id",
                  "value": "1",
                  "description": "Optional: enrollment context for progress mapping"
                }
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Fetch sorted structure of Modules, Lessons, and Topics. Optionally fetches lesson completion rates and lock status for students."
          }
        }
      ]
    },
    {
      "name": "2. Module Management",
      "item": [
        {
          "name": "Create and Link Module to Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Module 1: Getting Started with Java Syntax\",\n  \"description\": \"Write basics like data types, print statements, and control flow in Java.\",\n  \"order_num\": 1,\n  \"is_locked\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses/:courseId/modules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses",
                ":courseId",
                "modules"
              ],
              "variable": [
                {
                  "key": "courseId",
                  "value": "1",
                  "description": "Course ID to link this module under"
                }
              ]
            },
            "description": "Add a new module to a course."
          }
        },
        {
          "name": "Update Module",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Module 1: Advanced Java Syntax (Updated)\",\n  \"description\": \"Revised description for basic syntax, loops, and conditions.\",\n  \"order_num\": 1,\n  \"is_locked\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/modules/:moduleId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "modules",
                ":moduleId"
              ],
              "variable": [
                {
                  "key": "moduleId",
                  "value": "1"
                }
              ]
            },
            "description": "Update name, description, lock state, or order number of a module."
          }
        },
        {
          "name": "Delete Module",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/modules/:moduleId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "modules",
                ":moduleId"
              ],
              "variable": [
                {
                  "key": "moduleId",
                  "value": "1"
                }
              ]
            },
            "description": "Delete a module. Also cascades and soft-deletes/hard-deletes related children in lessons/topics database layer."
          }
        }
      ]
    },
    {
      "name": "3. Lesson Management",
      "item": [
        {
          "name": "Create and Link Lesson to Module",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lesson 1.1: Environment Setup\",\n  \"type\": \"mixed\",\n  \"content_text\": \"How to set up IntelliJ IDEA and JDK 17 on Windows and macOS.\",\n  \"duration_minutes\": 20,\n  \"order_num\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/modules/:moduleId/lessons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "modules",
                ":moduleId",
                "lessons"
              ],
              "variable": [
                {
                  "key": "moduleId",
                  "value": "1"
                }
              ]
            },
            "description": "Create a lesson under a module. Type must be one of: video, text, image, mixed."
          }
        },
        {
          "name": "Update Lesson",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lesson 1.1: Local JVM and IDE Setup (Updated)\",\n  \"type\": \"video\",\n  \"video_url\": \"https://example.com/videos/java-setup-revised.mp4\",\n  \"duration_minutes\": 25,\n  \"order_num\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/lessons/:lessonId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "lessons",
                ":lessonId"
              ],
              "variable": [
                {
                  "key": "lessonId",
                  "value": "1"
                }
              ]
            },
            "description": "Update lesson details, contents, video/pdf urls, type or duration."
          }
        },
        {
          "name": "Delete Lesson",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/lessons/:lessonId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "lessons",
                ":lessonId"
              ],
              "variable": [
                {
                  "key": "lessonId",
                  "value": "1"
                }
              ]
            },
            "description": "Delete a lesson. Cascades child topics."
          }
        }
      ]
    },
    {
      "name": "4. Topic Management",
      "item": [
        {
          "name": "Create and Link Topic to Lesson",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Topic 1.1.1: Compiling Java Bytecode\",\n  \"description\": \"Introduction to javac compiler and JVM architecture.\",\n  \"content_text\": \"The javac tool compiles Java source files (.java) into bytecode files (.class) containing JVM executable instructions.\",\n  \"order_num\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/lessons/:lessonId/topics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "lessons",
                ":lessonId",
                "topics"
              ],
              "variable": [
                {
                  "key": "lessonId",
                  "value": "1"
                }
              ]
            },
            "description": "Create a topic under a lesson. Topics represent individual concept pages."
          }
        },
        {
          "name": "Update Topic",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Topic 1.1.1: JVM and JIT Compilation (Updated)\",\n  \"content_text\": \"How the JVM interprets bytecode and uses the JIT compiler to compile hot paths into native code.\",\n  \"order_num\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/topics/:topicId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "topics",
                ":topicId"
              ],
              "variable": [
                {
                  "key": "topicId",
                  "value": "1"
                }
              ]
            },
            "description": "Update details, order number, or contents of a topic."
          }
        },
        {
          "name": "Delete Topic",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/topics/:topicId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "topics",
                ":topicId"
              ],
              "variable": [
                {
                  "key": "topicId",
                  "value": "1"
                }
              ]
            },
            "description": "Delete a topic."
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ]
}
